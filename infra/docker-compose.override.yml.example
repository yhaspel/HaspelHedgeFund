# Copy to docker-compose.override.yml and tweak locally without committing.
services:
  web:
    environment:
      DJANGO_DEBUG: "1"
  # Example: expose Postgres on a different port locally
  # db:
  #   ports:
  #     - "127.0.0.1:55432:5432"
  # Example: publish Redis for a backend run outside Docker (6380, so it can't
  # collide with a native Redis on 6379). Compose reads this override only when
  # no -f is given (e.g. the infra/*.sh scripts); with -f, pass both files.
  # redis:
  #   ports:
  #     - "127.0.0.1:6380:6379"
