# Postgres
POSTGRES_DB=hedgefund
POSTGRES_USER=hedgefund
POSTGRES_PASSWORD=hedgefund
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django
# DJANGO_ENV gates the insecure-secret guard in settings/base.py.
# Allowed values: dev | test | staging | prod. Anything other than dev/test
# refuses to start with the placeholder secrets below.
DJANGO_ENV=dev
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=1
DJANGO_SETTINGS_MODULE=hedgefund.settings.dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web
# Self-service signup. 1 (default) = POST /api/auth/signup/ creates accounts, so
# a fresh self-hosted clone can register its first user. Set to 0 on a
# single-user/personal deployment to lock the endpoint down (returns 403); you
# then log in with an account that already exists. See guides/railway-deploy.md.
SIGNUP_ENABLED=1

# JWT
# Dev default is intentionally insecure but at least 32 bytes long so SimpleJWT
# does not emit length warnings on every test run. For staging/prod, generate a
# unique key, e.g.: `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
JWT_SIGNING_KEY=dev-insecure-not-for-prod-not-for-prod-32b-sentinel

# Field encryption (ADR 0022). Encrypts BYO provider keys + broker credentials at
# rest, decoupled from DJANGO_SECRET_KEY so rotating the secret no longer bricks
# stored keys. Leave blank in dev (falls back to the SECRET_KEY-derived key);
# REQUIRED in staging/prod (the boot guard refuses to start without it). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Celery / Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# CORS — list both hostnames so the SPA loads from either localhost or 127.0.0.1.
CORS_ALLOWED_ORIGINS=http://localhost:4111,http://127.0.0.1:4111

# External providers (P1)
FMP_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
EDGAR_USER_AGENT=Your Name your-email@example.com

# External providers (P2b)
FRED_API_KEY=
TIINGO_API_KEY=

# Offline mode (P4-OFF, ADR 0029). OFFLINE_MODE=1 makes the app usable with no
# internet: external data providers are fenced (reads serve last-persisted DB
# rows), every LLM call is forced onto the local Ollama model, and outward-facing
# periodic tasks no-op. See guides/offline-mode.md.
#   * OFFLINE_LLM_MODEL — the Ollama tag every agent runs on offline. Stay inside
#     the 24 GB M4 envelope: qwen2.5:7b (default) is proven; >14B is excluded.
#   * OLLAMA_HOST — where the daemon lives. Ollama runs on the HOST
#     (infra/ollama-start.sh), so the compose containers default to
#     host.docker.internal (set in docker-compose.yml); a native/host run uses
#     http://localhost:11434.
OFFLINE_MODE=0
OFFLINE_LLM_MODEL=qwen2.5:7b
OLLAMA_HOST=http://host.docker.internal:11434

# P7 / P14 — Autonomous Alpaca paper fund on ONE shared account. The fund's
# member strategies each trade a sleeve (slice) of a single paper account; the
# FIRST complete triple below (or `--slot N`) is that account. Extra triples are
# still connected as plain paper accounts (not in the fund). NAME is a human
# label that becomes the BrokerAccount.label. ALPACA_FUND_OWNER_EMAIL is the
# Django user that owns the account/strategies/autopilots/fund. Run
# `manage.py bootstrap_autonomous_fund` after filling these — or skip the CLI
# and set everything up on the Autonomous Fund tab (Manage fund). Paper-only.
ALPACA_PAPER_1_NAME=multifactor-ls
ALPACA_PAPER_1_KEY_ID=
ALPACA_PAPER_1_SECRET=
ALPACA_PAPER_2_NAME=sector-rotation
ALPACA_PAPER_2_KEY_ID=
ALPACA_PAPER_2_SECRET=
ALPACA_PAPER_3_NAME=trend-cta
ALPACA_PAPER_3_KEY_ID=
ALPACA_PAPER_3_SECRET=
ALPACA_FUND_OWNER_EMAIL=

# Email / notifications (P3b)
# Dev defaults to the console backend (notifications print to the worker logs).
# For real delivery, set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# and the EMAIL_HOST/PORT/USER/PASSWORD/USE_TLS values for your provider.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
DEFAULT_FROM_EMAIL=Hedge Fund <hedgefund@localhost>
# Per-user/day cap on scheduled-run notifications (anti-fatigue).
NOTIFICATIONS_MAX_PER_DAY=10
# Telegram Bot API base (override only for testing). Per-channel bot_token +
# chat_id are entered in Settings → Notifications; see the in-app guide at
# frontend/public/guides/telegram-setup.md (served at /info/telegram-setup).
TELEGRAM_API_BASE=https://api.telegram.org

# Ops & safety (P5-SH)
# Default mid-run LLM-spend cap (USD) for runs whose own max_budget_usd is unset.
# Blank ⇒ off (no run-cost guard). Set e.g. 5 to abort any run that crosses $5.
RUN_DEFAULT_MAX_BUDGET_USD=
# Optional error reporting. Blank ⇒ Sentry is never imported or initialized.
# To opt in: set your DSN and install the extra (`uv sync --extra sentry`).
SENTRY_DSN=
# Perf-tracing sample rate for Sentry when enabled (0 = errors only).
SENTRY_TRACES_SAMPLE_RATE=0
