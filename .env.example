# Postgres
POSTGRES_DB=hedgefund
POSTGRES_USER=hedgefund
POSTGRES_PASSWORD=hedgefund
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=1
DJANGO_SETTINGS_MODULE=hedgefund.settings.dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web

# JWT
JWT_SIGNING_KEY=dev-insecure-change-me

# Celery / Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200

# External providers (P1)
FMP_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
EDGAR_USER_AGENT=Your Name your-email@example.com
