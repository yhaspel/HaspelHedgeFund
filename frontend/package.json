{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "check:inline-styles": "node scripts/check-inline-styles.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:no-native-dialogs": "node scripts/check-no-native-dialogs.mjs",
    "e2e": "playwright test --config e2e/playwright.config.ts --project=chromium",
    "e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "e2e:headed": "playwright test --config e2e/playwright.config.ts --headed --project=chromium",
    "e2e:debug": "PWDEBUG=1 playwright test --config e2e/playwright.config.ts",
    "e2e:report": "playwright show-report e2e-results/html",
    "e2e:codegen": "playwright codegen http://localhost:4111",
    "e2e:visual": "playwright test --config e2e/playwright.config.ts --project=visual",
    "e2e:axe": "playwright test --config e2e/playwright.config.ts --project=axe",
    "e2e:update-snapshots": "playwright test --config e2e/playwright.config.ts --project=visual --update-snapshots",
    "e2e:live": "E2E_LANE=live playwright test --config e2e/playwright.config.ts --project=live-smoke",
    "e2e:sw": "playwright test --config e2e/playwright.offline.config.ts",
    "e2e:routes": "node e2e/utils/check-fixtures.mjs"
  },
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.0",
    "chart.js": "^4.5.1",
    "marked": "^18.0.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.11",
    "@angular/cli": "^21.2.11",
    "@angular/compiler-cli": "^21.2.0",
    "@axe-core/playwright": "^4.11.3",
    "@guidepup/virtual-screen-reader": "^0.32.1",
    "@playwright/test": "~1.60.0",
    "@types/node": "^22.19.19",
    "autoprefixer": "^10.5.0",
    "axe-core": "^4.11.4",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.9.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.14",
    "prettier": "^3.8.1",
    "serve": "^14.2.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "lmdb",
      "msgpackr-extract"
    ]
  }
}