# Secrets — never bake into an image layer.
.env
.env.*
!.env.example

# VCS
.git
.gitignore

# Python
# NB: these use **/ because a bare `foo/` pattern only matches at the context
# ROOT — `.venv/` never excluded `backend/.venv`, so a developer's 330 MB macOS
# virtualenv was copied into the Linux image by `COPY backend/ /app/` (P12).
**/__pycache__/
*.py[cod]
*.egg-info/
**/.venv/
**/venv/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
.coverage
htmlcov/
*.sqlite3

# Node / Angular
# Same root-only caveat as above: `node_modules/` did not exclude
# `frontend/node_modules`, so host (macOS) modules overwrote the deps stage's
# Linux install and pnpm aborted the build trying to purge them.
**/node_modules/
**/dist/
**/.angular/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
frontend/.pnpm-store/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local overrides + scratch
infra/docker-compose.override.yml
backend/media/
MEMORY.md
.tmp-screenshots/

# Claude Code session state — never relevant to a built image.
.claude/
